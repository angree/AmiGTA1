# LF everywhere. The shell scripts run under WSL and the startup script runs
# under AmigaDOS; neither wants CRLF, and Windows checkouts default to adding
# it. The one file that must not be touched at all is the Workbench icon.
* text=auto eol=lf

*.info binary
*.raw  binary

# The two Kalms kernels are included verbatim. Their line endings are theirs
# too - nothing here rewrites a file that carries somebody else's name.
native/c2p1x1_6_c5_bm_040.s -text
native/c2p_rect.s           -text
